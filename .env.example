# ── Frontend (Next.js statik yayın) ─────────────────────────────
# Bu değerler tarayıcıya gider; herkese açık olmaları güvenlidir.
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# GitHub Pages proje sayfası için repo adı (yerelde boş bırakın)
NEXT_PUBLIC_BASE_PATH=/ustatakip
# Paylaşım linklerinde kullanılacak tam adres (yerelde boş bırakın)
NEXT_PUBLIC_SITE_URL=https://<kullanıcı>.github.io/ustatakip

# ── Supabase Edge Function secret'ları ──────────────────────────
# BUNLARI ASLA .env dosyasına yazıp commit'lemeyin. Supabase panelinden
# (Edge Functions > Secrets) ya da `npx supabase secrets set` ile girin.
# SUPABASE_URL ve SUPABASE_SERVICE_ROLE_KEY Supabase tarafından otomatik sağlanır.
# IP_HASH_SECRET=<en az 32 karakter rastgele değer>   (isteğe bağlı; yoksa Supabase Vault kullanılır)
# ALLOWED_ORIGINS=https://<kullanıcı>.github.io,http://localhost:3000
